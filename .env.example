# Optional. Mission Control works with its built-in forecast engine without these.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Required for every production deployment. This exact sign-in email becomes the first owner.
OWNER_EMAIL=

# Use `cloudflare-access` on the native Cloudflare Pages deployment and `sites` on OpenAI Sites.
AUTH_PROVIDER=cloudflare-access

# Required when AUTH_PROVIDER=cloudflare-access. The Access application supplies both values.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Required for the legacy Google Form bridge. Keep the full export or proxy URL
# in server-side environment settings; it must never be shipped to the browser.
TRACKER_CSV_URL=

# Optional when TRACKER_CSV_URL points to an authenticated CSV proxy.
TRACKER_SYNC_BEARER_TOKEN=

# Optional. Required before email delivery can be switched from Review to On.
RESEND_API_KEY=
ALERT_FROM_EMAIL=
ALERT_RECIPIENTS=

# Optional while reports remain in Review. Required before a scheduler can call /api/automation/run.
AUTOMATION_SECRET=
